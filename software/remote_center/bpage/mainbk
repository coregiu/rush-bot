#include "esp_camera.h"
#include "Arduino.h"
#include "driver/i2c.h"
// 这里必须填你板子的 SDA / SCL 引脚
// 绝大多数 ESP32-S3 CAM 通用：
#define CAM_SDA 21
#define CAM_SCL 22

// 摄像头 ID 寄存器
#define REG_PIDH 0x0A  // 高字节
#define REG_PIDL 0x0B  // 低字节

// 两个摄像头的 SCCB 地址
#define OV2640_ADDR 0x30
#define OV3660_ADDR 0x3C

// 简化读寄存器函数
uint8_t cam_read(uint8_t slv_addr, uint8_t reg) {
  i2c_cmd_handle_t cmd = i2c_cmd_link_create();
  uint8_t data = 0;

  i2c_master_start(cmd);
  i2c_master_write_byte(cmd, (slv_addr << 1) | I2C_MASTER_WRITE, true);
  i2c_master_write_byte(cmd, reg, true);
  i2c_master_start(cmd);
  i2c_master_write_byte(cmd, (slv_addr << 1) | I2C_MASTER_READ, true);
  i2c_master_read_byte(cmd, &data, I2C_MASTER_NACK);
  i2c_master_stop(cmd);
  esp_err_t ret = i2c_master_cmd_begin(I2C_NUM_0, cmd, 10 / portTICK_PERIOD_MS);
  i2c_cmd_link_delete(cmd);

  return ret == ESP_OK ? data : 0;
}

// 读取传感器 ID
uint16_t read_camera_id(uint8_t addr) {
  uint8_t h = cam_read(addr, REG_PIDH);
  uint8_t l = cam_read(addr, REG_PIDL);
  return (h << 8) | l;
}

// I2C 初始化
void i2c_init() {
  i2c_config_t conf;
  conf.mode = I2C_MODE_MASTER;
  conf.sda_io_num = CAM_SDA;
  conf.scl_io_num = CAM_SCL;
  conf.sda_pullup_en = GPIO_PULLUP_ENABLE;
  conf.scl_pullup_en = GPIO_PULLUP_ENABLE;
  conf.master.clk_speed = 100000;
  conf.clk_flags = 0;

  i2c_param_config(I2C_NUM_0, &conf);
  i2c_driver_install(I2C_NUM_0, conf.mode, 0, 0, 0);
}

void setup() {
  Serial.begin(9600);
  delay(1000);
  Serial.println("开始检测摄像头型号...");

  i2c_init();

  // 先读 OV2640 地址
  uint16_t id1 = read_camera_id(OV2640_ADDR);
  // 再读 OV3660 地址
  uint16_t id2 = read_camera_id(OV3660_ADDR);

  Serial.printf("OV2640地址 ID: 0x%04X\n", id1);
  Serial.printf("OV3660地址 ID: 0x%04X\n", id2);

  // 判断
  if (id1 == 0x2640) {
    Serial.println("✅ 摄像头 = OV2640");
  } else if (id2 == 0x3660) {
    Serial.println("✅ 摄像头 = OV3660");
  } else {
    Serial.println("❌ 未识别摄像头");
  }
}

void loop() {
}